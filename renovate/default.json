{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Règles Renovate communes à tous les dépôts CubixMC.",
  "extends": ["config:recommended", ":dependencyDashboard"],
  "timezone": "Europe/Brussels",
  "schedule": ["before 6am on monday"],
  "labels": ["dépendances"],
  "packageRules": [
    {
      "description": "Minestom, Velocity et Via : alerte immédiate, chaque version de Minecraft en dépend.",
      "matchPackageNames": ["net.minestom:**", "com.velocitypowered:**", "ViaVersion/**"],
      "groupName": "Minecraft (Minestom, Velocity, Via)",
      "schedule": ["at any time"],
      "labels": ["minecraft"]
    },
    {
      "description": "Outillage qualité et tests, groupés pour limiter le bruit.",
      "matchPackageNames": [
        "org.junit:**",
        "org.assertj:**",
        "com.google.errorprone:**",
        "com.uber.nullaway:**",
        "com.palantir.javaformat:**",
        "com.diffplug.spotless:**",
        "net.ltgt.gradle:**"
      ],
      "groupName": "outillage qualité"
    },
    {
      "description": "Log4j : le proxy compile contre celui que Velocity embarque, on le suit à la main.",
      "matchPackageNames": ["org.apache.logging.log4j:**"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "description": "Versions annotées « # renovate: » dans le catalogue (ex. ViaVersion pour le proxy de test).",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)libs\\.versions\\.toml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[a-z0-9-]+ = \"(?<currentValue>[^\"]+)\""
      ]
    }
  ]
}
